---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="mb-5">
		<h1>Tattoo Removal</h1>
		<p class="text-xl bg-[#EEE8E0] px-2">Pre-Treatment Instructions</p>
	</section>
	<section>
		<div class="separation">
			<h2>Before Your Treatment</h2>
			<p>	• Avoid sun exposure and tanning for 4 weeks. <br>
				• Avoid retinoids for 5–7 days. <br>
				• Arrive with clean skin. <br>
				• Inform your provider of medications or health changes. <br>
			</p>
		</div>
	</section>
</Layout>
