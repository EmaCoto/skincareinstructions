---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
export function getStaticPaths() { return products.map((product,index) => ({ params:{slug:product.slug}, props:{product,index} })); }
const { product,index } = Astro.props;
const front = `/cards/card-${String(index*2+1).padStart(2,'0')}.webp`;
const back = `/cards/card-${String(index*2+2).padStart(2,'0')}.webp`;
---
<Layout title={`${product.name} | Skincare Instructions`} description={`Skincare instructions for ${product.name}.`}>
 <main class="product-page">
  <a class="back-link" href="/">← All products</a>
  <header class="product-hero"><p class="eyebrow">{product.brand}</p><h1>{product.name}</h1>{product.detail && <p class="product-detail">{product.detail}</p>}</header>
  <section class="original-cards" aria-label={`${product.name} information cards`}>
   <figure class="card-side"><img src={front} alt={`${product.name} information — front`} /></figure>
   <figure class="card-side card-side--back"><img src={back} alt={`${product.name} information — back`} /><a class="qr-replacement" href="https://kiwimedspa.com/" target="_blank" rel="noreferrer"><span>VISIT</span><strong>kiwimedspa.com</strong><span>↗</span></a></figure>
  </section>
 </main>
</Layout>
